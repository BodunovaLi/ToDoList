<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:components="clr-namespace:ToDoList.Views.Components"
    x:Class="ToDoList.MainPage"
    BackgroundColor="#10111C"
    Shell.NavBarIsVisible="False">

    <!-- Основной контейнер страницы -->
    <Grid Padding="20,30">
        <Grid
            RowDefinitions="Auto,Auto,*"
            RowSpacing="25"
            MaximumWidthRequest="1000"
            HorizontalOptions="Fill">

            <!-- 1. Заголовок страницы -->
            <VerticalStackLayout
                Grid.Row="0"
                Spacing="1">

                <Label
                    Text="Мои задачи"
                    FontSize="28"
                    FontAttributes="Bold"
                    TextColor="White"/>

                <Label
                    Text="Планируй сегодня&#10;для лучшего завтра"
                    FontSize="14"
                    TextColor="#A0A0B0"/>

            </VerticalStackLayout>

            <!-- 2. Категории -->
            <FlexLayout
                Grid.Row="1"
                Direction="Row"
                Wrap="Wrap"
                JustifyContent="Start"
                AlignItems="Center"
                BindableLayout.ItemsSource="{Binding Categories}">

                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <components:CategoryCardView Margin="0,0,10,10"/>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>

            </FlexLayout>

            <!-- 3. Основной контент -->
            <Grid Grid.Row="2">

                <!-- 3.1. Пустое состояние -->
                <ScrollView
                    IsVisible="{Binding IsEmpty}"
                    Orientation="Vertical">

                    <VerticalStackLayout
                        Spacing="15"
                        MaximumWidthRequest="400"
                        HorizontalOptions="Center"
                        Padding="0,20">

                        <!-- Иллюстрация -->
                        <Grid
                            MaximumWidthRequest="300"
                            HorizontalOptions="Fill">

                            <Image
                                Source="notasks.png"
                                Aspect="AspectFit"
                                HorizontalOptions="Fill"
                                VerticalOptions="Center"/>

                        </Grid>

                        <!-- Заголовок и описание -->
                        <VerticalStackLayout Spacing="10">

                            <Label
                                Text="Задач пока нет"
                                FontSize="24"
                                FontAttributes="Bold"
                                TextColor="White"
                                HorizontalTextAlignment="Center"/>

                            <Label
                                Text="Создайте первую задачу, чтобы начать"
                                FontSize="14"
                                TextColor="#A0A0B0"
                                HorizontalTextAlignment="Center"/>

                        </VerticalStackLayout>

                        <!-- Кнопка создания задачи -->
                        <Border
                            BackgroundColor="#6546DF"
                            Stroke="#A48BFF"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            Padding="20,15"
                            Margin="0,20,0,0"
                            HorizontalOptions="Fill">

                            <HorizontalStackLayout
                                Spacing="15"
                                HorizontalOptions="Center">

                                <Label
                                    Text="+"
                                    FontSize="24"
                                    TextColor="White"
                                    VerticalOptions="Center"/>

                                <Label
                                    Text="Создать задачу"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    TextColor="White"
                                    VerticalOptions="Center"/>

                            </HorizontalStackLayout>

                        </Border>

                    </VerticalStackLayout>

                </ScrollView>

                <!-- 3.2. Список задач -->
                <CollectionView
                    IsVisible="{Binding HasTasks}"
                    ItemsSource="{Binding Tasks}"
                    ItemSizingStrategy="MeasureAllItems">

                    <!-- Расстояние между карточками -->
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout
                            Orientation="Vertical"
                            ItemSpacing="12"/>
                    </CollectionView.ItemsLayout>

                    <!-- Шаблон одной карточки -->
                    <CollectionView.ItemTemplate>
                        <DataTemplate>

                            <components:TaskCardView/>

                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>

            </Grid>

        </Grid>

    </Grid>

</ContentPage>