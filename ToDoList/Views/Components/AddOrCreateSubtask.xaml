<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="ToDoList.Views.Components.AddOrCreateSubtask"
    x:Name="DialogRoot"
    HorizontalOptions="Fill"
    VerticalOptions="Fill">

    <!-- Затемнение занимает всё доступное пространство. -->
    <Grid
        BackgroundColor="#99000000"
        Padding="24">

        <!-- Окно диалога находится по центру. -->
        <Border
            BackgroundColor="#1B1B2A"
            Stroke="#343546"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 16"
            Padding="24"
            WidthRequest="440"
            MaximumWidthRequest="900"
            HorizontalOptions="Center"
            VerticalOptions="Center">

            <VerticalStackLayout Spacing="22">

                <Label
                    x:Name="DialogTitle"
                    Text="Добавить подзадачу"
                    FontSize="18"
                    FontAttributes="Bold"
                    TextColor="White"
                    HorizontalTextAlignment="Center"
                    LineBreakMode="WordWrap"/>

                <Entry
                    x:Name="SubtaskNameEntry"
                    Placeholder="Название подзадачи..."
                    BackgroundColor="#1E1F2A"/>

                <Grid
                    ColumnDefinitions="*,*"
                    ColumnSpacing="12">

                    <Button
                        Grid.Column="0"
                        Text="Отмена"
                        Clicked="GoBack"
                        BackgroundColor="#2C2C3E"
                        TextColor="White"
                        FontSize="14"
                        CornerRadius="10"
                        BorderWidth="0"
                        Padding="12,10"/>

                    <Button
                        Clicked="OnAddClicked"
                        Grid.Column="1"
                        x:Name="ConfirmButton"
                        Text="Добавить"
                        BackgroundColor="#6546DF"
                        TextColor="White"
                        FontSize="14"
                        CornerRadius="10"
                        BorderWidth="0"
                        Padding="12,10"/>

                </Grid>

            </VerticalStackLayout>

        </Border>

    </Grid>

</ContentView>
